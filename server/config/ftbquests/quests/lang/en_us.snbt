	quest.5350010000020016.title: "&eScaled Logistics&r"
	quest.5350010000020017.quest_subtitle: "Completes when the Empowerer capstone is complete."
	quest.5350010000020017.title: "&eAdvanced Applied Industry&r"
	quest.5350010000020018.quest_subtitle: "Completes when the Aquatic Catalyst capstone is complete."
	quest.5350010000020018.title: "&eNauTec Oceanic Industry&r"
	quest.5350010000020019.quest_subtitle: "Completes when the Processing Unit capstone is complete."
